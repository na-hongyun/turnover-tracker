// schema.prisma 파일 수정

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // 기존 env("DATABASE_URL")을 지우고 아래처럼 파일 경로를 직접 적어줍니다.
  url      = "file:./dev.db" 
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id               String   @id @default(cuid())
  barcode          String   @unique
  name             String
  currentStock     Int
  shipmentM1       Int
  shipmentM2       Int
  shipmentM3       Int
  seasonalityIndex Float    @default(1.0)
  leadTime         Int      @default(14)
  unitPrice        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}