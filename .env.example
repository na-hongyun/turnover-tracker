# PostgreSQL connection (required for Vercel — SQLite files do not work on serverless)
# Neon example: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Random string for JWT session signing (required in production)
SESSION_SECRET="change-this-to-a-long-random-string-in-production"
